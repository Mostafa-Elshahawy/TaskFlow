# Copy this file to .env and replace the value with a strong local password.
MSSQL_SA_PASSWORD=replace-with-a-strong-local-password

# Optional: when both values are set, startup creates or promotes this global administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

CLIENT_BASE_URL=http://localhost:4200
